{
  "name": "@hackspain/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "deploy:dry": "vite build && wrangler deploy --dry-run --config dist/hackspain_web/wrangler.json",
    "deploy": "vite build && wrangler deploy --config dist/hackspain_web/wrangler.json",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && wrangler deploy --config dist/hackspain_web/wrangler.json"
  },
  "dependencies": {
    "@ai-sdk/vue": "4.0.107",
    "@hackspain/shared": "workspace:*",
    "@lucide/vue": "1.47.0",
    "@vueuse/core": "15.0.0",
    "ai": "7.0.107",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-force": "3.0.0",
    "reka-ui": "2.10.4",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.43",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.11",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-force": "3.0.10",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
