{
  "name": "hackspain",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter './apps/*' dev",
    "format": "biome check .",
    "format:fix": "biome check --write .",
    "lint": "oxlint -c oxlint.config.mts --deny-warnings",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "deploy:dry": "bun --filter './apps/*' deploy:dry",
    "verify": "bun run format && bun run lint && bun run typecheck && bun run test && bun run deploy:dry",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@types/bun": "1.4.2",
    "lefthook": "2.1.14",
    "oxlint": "1.83.0",
    "secretlint": "13.0.5",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "wrangler": "4.133.0"
  }
}
